{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Clean and Build All (Debug)",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Clean All",
                "Configure EtherRecorder (Debug)",
                "Build EtherRecorder (Debug)"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Clean and Build All (Release)",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Clean All",
                "Configure EtherRecorder (Release)",
                "Build EtherRecorder (Release)"
            ],
            "group": "build"
        },
        {
            "label": "Clean All",
            "type": "shell",
            "windows": {
                "command": "if exist \"${workspaceFolder}\\build\\windows-arm64\" rmdir /s /q \"${workspaceFolder}\\build\\windows-arm64\""
            },
            "osx": {
                "command": "rm -rf \"${workspaceFolder}/build/macos-arm64\""
            }
        },
        {
            "label": "Configure EtherRecorder (Debug)",
            "type": "shell",
            "command": "cmake",
            "windows": {
                "args": ["--preset", "windows-arm64-debug"]
            },
            "osx": {
                "args": ["--preset", "macos-arm64-debug"]
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": {
                "owner": "cpp",
                "fileLocation": ["relative", "${workspaceFolder}"],
                "pattern": [
                    {
                        "regexp": "^(.*?)\\((\\d+),(\\d+)\\):\\s+(warning|error)\\s+(\\w+\\d+):\\s+(.*)$",
                        "file": 1,
                        "line": 2,
                        "column": 3,
                        "severity": 4,
                        "code": 5,
                        "message": 6
                    },
                    {
                        "regexp": "^(.*?)\\s+:\\s+(error|warning)\\s+(LNK\\d+):\\s+(.*)\\s+\\[(.*)\\]$",
                        "file": 5,
                        "severity": 2,
                        "code": 3,
                        "message": 4
                    },
                    {
                        "regexp": "^(.*?)\\s+:\\s+(fatal\\s+error|error|warning)\\s+(LNK\\d+):\\s+(.*)\\s+\\[(.*)\\]$",
                        "file": 5,
                        "severity": 2,
                        "code": 3,
                        "message": 4
                    },
                    {
                        "regexp": "^.*?\\((\\d+),(\\d+)\\):\\s+(warning|error)\\s+(\\w+\\d+):\\s+'(.*?)'\\s+(.*)$",
                        "line": 1,
                        "column": 2,
                        "severity": 3,
                        "code": 4,
                        "message": 6
                    },
                    {
                        "regexp": "^(.*?)\\((\\d+),(\\d+)\\):\\s+(warning|error)\\s+(\\w+\\d+):\\s+([\\s\\S]*?)\\s+\\[(.*)\\]$",
                        "file": 1,
                        "line": 2,
                        "column": 3,
                        "severity": 4,
                        "code": 5,
                        "message": 6
                    }
                ]
            }
        },
        {
            "label": "Configure EtherRecorder (Release)",
            "type": "shell",
            "command": "cmake",
            "windows": {
                "args": ["--preset", "windows-arm64-release"]
            },
            "osx": {
                "args": ["--preset", "macos-arm64-release"]
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": ["$msCompile", "$gcc"]
        },
        {
            "label": "Build EtherRecorder (Debug)",
            "type": "shell",
            "command": "cmake",
            "windows": {
                "args": [
                    "--build",
                    "--preset",
                    "windows-arm64-debug",
                    "--target",
                    "EtherRecorder",
                    "--config",
                    "debug"
                ]
            },
            "osx": {
                "args": [
                    "--build",
                    "--preset",
                    "macos-arm64-debug",
                    "--target",
                    "EtherRecorder"
                ]
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": ["$msCompile", "$gcc"]
        },
        {
            "label": "Build EtherRecorder (Release)",
            "type": "shell",
            "command": "cmake",
            "windows": {
                "args": [
                    "--build",
                    "--preset",
                    "windows-arm64-release",
                    "--target",
                    "EtherRecorder",
                    "--config",
                    "release"
                ]
            },
            "osx": {
                "args": [
                    "--build",
                    "--preset",
                    "macos-arm64-release",
                    "--target",
                    "EtherRecorder"
                ]
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": ["$msCompile", "$gcc"]
        }
    ]
}
